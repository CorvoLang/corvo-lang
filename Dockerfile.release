# Rust is needed to build the Corvo CLI and transpile to Rust projects
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --user-group corvo
# Update the corvo-lang version in Cargo.toml with the latest tag from the repository. Remember to remove the initial version `v` from the tag.
COPY . /app
COPY .git /app/.git
WORKDIR /app
RUN VERSION=$(git tag --list | sort -Vr | head -n 1) && \
    VERSION=${VERSION#v} && \
    rm -rf /app/target && \
    # Change only [package]'s version — first ^version = line in Cargo.toml
    sed -i "0,/^version = /s/^version = .*/version = \"$VERSION\"/" /app/Cargo.toml && \
    echo "VERSION: $VERSION" && \
    git diff Cargo.toml && \
    cargo install corvo-lang --path /app && \
    cp /usr/local/cargo/bin/corvo /usr/local/bin/corvo && \
    corvo --version && \
    rm -rf /app

WORKDIR /home/corvo
USER corvo

CMD ["corvo", "--repl"]
