# Generated by Cargo (repo root only — do not ignore vendor/**/debug|target)
/debug
/target
**/*.rs.bk

# MSVC Windows builds
*.pdb

# RustRover
#.idea/

# Corvo specific
*.cvo
*.corvob

# Environment
.env
.env.local
# sqlx (and similar) ship test fixture .env files inside the crate tarball
!vendor/**/.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
*.swp
*.swo
*~
# some crates ship .vscode settings in their published sources
!vendor/**/.vscode/
!vendor/**/.vscode/**

# Testing
coverage/
**/transpiled/**
.tmp-test/
