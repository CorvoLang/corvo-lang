# Print the numeric identifier for the current host.
prep {
  static.set("version", os.get_env("COREUTILS_VERSION", "0.0.0-dev"))
}
@parsed = args.parse(os.argv(), {})
@o = @parsed["options"]
if (@o.get("help", false)) {
  sys.echo("Usage: hostid")
  sys.echo("Print the numeric identifier for the current host.")
  sys.exit(0)
}
if (@o.get("version", false)) {
  sys.echo("hostid (Corvo coreutils) " + static.get("version"))
  sys.exit(0)
}
sys.echo(os.hostid())
