# Do nothing, unsuccessfully.
prep {
  static.set("version", os.get_env("COREUTILS_VERSION", "0.0.0-dev"))
}
@parsed = args.parse(os.argv(), {})
@o = @parsed["options"]
if (@o.get("help", false)) {
  sys.echo("Usage: false")
  sys.echo("Exit with a status code indicating failure.")
  sys.exit(0)
}
if (@o.get("version", false)) {
  sys.echo("false (Corvo coreutils) " + static.get("version"))
  sys.exit(0)
}
sys.exit(1)
