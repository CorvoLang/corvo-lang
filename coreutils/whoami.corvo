# Print the user name associated with the current effective user ID.
prep {
  static.set("version", os.get_env("COREUTILS_VERSION", "0.0.0-dev"))
}
@parsed = args.parse(os.argv(), {})
@o = @parsed["options"]
if (@o.get("help", false)) {
  sys.echo("Usage: whoami [OPTION]...")
  sys.echo("Print the user name associated with the current effective user ID.")
  sys.echo("")
  sys.echo("      --help     display this help and exit")
  sys.echo("      --version  output version information and exit")
  sys.exit(0)
}
if (@o.get("version", false)) {
  sys.echo("whoami (Corvo coreutils) " + static.get("version"))
  sys.exit(0)
}
sys.echo(os.username())
