# Print machine architecture.
prep {
  static.set("version", os.get_env("COREUTILS_VERSION", "0.0.0-dev"))
}
@parsed = args.parse(os.argv(), {})
@o = @parsed["options"]
if (@o.get("help", false)) {
  sys.echo("Usage: arch")
  sys.echo("Print machine architecture.")
  sys.exit(0)
}
if (@o.get("version", false)) {
  sys.echo("arch (Corvo coreutils) " + static.get("version"))
  sys.exit(0)
}
sys.echo(os.info()["arch"])
